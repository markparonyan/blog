---
import BaseLayout from "../../layouts/BaseLayout.astro";
import entries from "../../data/workout.json";
import { exercises, validateEntries } from "../../lib/workout";

const records = validateEntries(entries);
const months = [...new Set(records.map((entry) => entry.date.slice(0, 7)))];
const dateLabel = (date: string, options: Intl.DateTimeFormatOptions) =>
	new Intl.DateTimeFormat("en", { ...options, timeZone: "UTC" }).format(new Date(`${date}T12:00:00Z`));
---

<BaseLayout title="Workout" description="A personal workout record and one-round core timer." htmlClass="workout-document" class="workout-page" showPhotoShortcut={false}>
	<main class="workout-shell">
		<header class="intro"><h1>workout.</h1></header>

		<section class="record" aria-labelledby="record-heading">
			<h2 id="record-heading">Your record</h2>
			{records.length === 0 ? (
				<p class="empty-record meta">No entries yet. Only dates you commit appear here.</p>
			) : months.map((month) => (
				<div class="record-month">
					<h3 class="meta">{dateLabel(`${month}-01`, { month: "long", year: "numeric" })}</h3>
					<ul class="record-dates" role="list">
						{records.filter((entry) => entry.date.startsWith(month)).map((entry) => (
							<li class="record-entry">
								<time class="date-mark" datetime={entry.date} aria-label={`${dateLabel(entry.date, { month: "long", day: "numeric", year: "numeric" })}: ${entry.status === "done" ? "workout done" : "skipped"}`}>
									<span aria-hidden="true">{Number(entry.date.slice(8))}</span>
									{entry.status === "skipped" && <svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true"><path d="m2 2 6 6m0-6L2 8" stroke="currentColor" stroke-width="1.4" /></svg>}
								</time>
								<span class="record-label" aria-hidden="true">{dateLabel(entry.date, { weekday: "short" })}</span>
							</li>
						))}
					</ul>
				</div>
			))}
		</section>

		<workout-timer>
			<section class="session-section" aria-labelledby="session-heading">
				<header class="section-header">
					<h2 id="session-heading">The session</h2>
					<p class="meta">1 round · <span id="total">06:00</span> total</p>
				</header>
				<div class="session">
					<div>
						<p id="position" class="meta">01 / 09</p>
						<h3 id="exercise-name" class="exercise-name">W Raises</h3>
						<p id="exercise-hint" class="meta">10 reps · slow &amp; controlled</p>
						<p class="next meta">Next <span id="next-name">Knee Slides</span></p>
						<p id="announcement" class="session-message meta" role="status"></p>
					</div>
					<div class="timer-panel">
						<div class="timer-row"><span id="timer" role="timer" aria-live="off">00:40</span><span class="meta">remaining</span></div>
						<div id="progress" class="progress" role="progressbar" aria-label="Session progress" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><span id="bar"></span></div>
						<div class="controls">
							<button id="previous" class="action" type="button" aria-label="Previous exercise" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg></button>
							<button id="toggle" class="action primary" type="button" disabled>Start session</button>
							<button id="next-exercise" class="action" type="button" aria-label="Skip to next exercise" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg></button>
						</div>
						<div class="settings meta">
							<label for="duration">Per move <input id="duration" type="number" min="20" max="90" step="5" value="40" inputmode="numeric" disabled /> s</label>
							<button id="reset" class="quiet" type="button" disabled>Reset</button>
						</div>
						<div class="audio-settings">
							<div class="volume-row meta">
								<label for="volume">Alert volume</label>
								<output id="volume-value" for="volume">70%</output>
								<button id="test-sound" class="quiet" type="button" disabled>Test sound</button>
							</div>
							<input id="volume" type="range" min="0" max="100" step="1" value="70" aria-label="Alert volume" disabled />
							<p class="audio-help meta">Test over your music. Uses device volume; keep this page open and screen on.</p>
							<p id="audio-status" class="meta" role="status"></p>
						</div>
					</div>
				</div>
				<noscript><p class="meta">Enable JavaScript to use the timer and sound alerts.</p></noscript>
			</section>

			<section class="exercises-section" aria-labelledby="exercises-heading">
				<header class="section-header exercise-header"><h2 id="exercises-heading">The exercises</h2><p class="meta">In order · no rest between moves</p></header>
				<ol class="exercise-grid" role="list">
					{exercises.map((exercise, index) => (
						<li class="exercise-tile" data-exercise={index}>
							<div class="tile-top meta"><span>{String(index + 1).padStart(2, "0")}</span><span data-move-duration>40 s</span></div>
							<div><h3>{exercise.name}</h3><p class="meta tile-hint">{exercise.hint}</p></div>
							<p class="tile-focus">{exercise.focus}</p>
						</li>
					))}
				</ol>
			</section>
		</workout-timer>
	</main>
</BaseLayout>

<script>
	import "../../scripts/workout";
</script>

<style is:global>
	html.workout-document { background: #0d0d0d; color-scheme: dark; font-size: 16px; --color-bg: #0d0d0d; --color-text: #ededeb; --color-muted: #909090; --color-rule: #292929; }
	.workout-page { background: #0d0d0d; color: #b8b8b8; font: 14px/1.6 var(--font-mono); font-variant-numeric: tabular-nums; }
</style>

<style>
	.workout-shell { max-width: 960px; margin: auto; padding: env(safe-area-inset-top) 32px max(24px, env(safe-area-inset-bottom)); }
	h1, h2, h3 { color: var(--color-text); font-family: inherit; font-weight: 400; letter-spacing: 0; }
	h1 { font-size: 28px; line-height: 1.3; }
	h2, .exercise-tile h3 { font-size: 20px; line-height: 1.4; }
	p, ul, ol { margin: 0; }
	button, input { color: inherit; }
	button { cursor: pointer; touch-action: manipulation; }
	button:disabled { opacity: .4; cursor: default; }
	button:focus-visible, input:focus-visible { outline: 2px solid var(--color-text); outline-offset: 4px; }
	.intro { padding: 48px 0 40px; }
	.meta { color: var(--color-muted); font-size: 12px; }
	.record { padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); }
	.record > h2 { margin-bottom: 24px; }
	.empty-record { padding: 24px 0; }
	.record-month + .record-month { margin-top: 24px; }
	.record-month h3 { margin-bottom: 16px; }
	.record-dates { display: flex; flex-wrap: wrap; gap: 16px; padding: 0; list-style: none; }
	.record-entry { display: flex; flex-direction: column; align-items: center; gap: 8px; }
	.date-mark { display: flex; width: 48px; height: 48px; flex-direction: column; justify-content: center; align-items: center; gap: 2px; border-radius: 50%; background: #ededeb; color: #0d0d0d; }
	.record-label { font-size: 11px; color: var(--color-muted); }
	workout-timer { display: block; }
	.session-section { padding: 48px 0; border-bottom: 1px solid var(--color-rule); }
	.section-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 32px; }
	.session { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; }
	.exercise-name { margin: 12px 0 8px; font-size: 28px; line-height: 1.4; }
	.next { margin-top: 32px; }
	.next span { margin-left: 12px; color: #b8b8b8; }
	.session-message { margin-top: 16px; max-width: 320px; }
	.timer-row { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
	#timer { font-size: 88px; line-height: 1; letter-spacing: -.06em; color: var(--color-text); }
	.progress { height: 2px; background: var(--color-rule); margin: 24px 0; }
	.progress span { display: block; width: 0; height: 100%; background: var(--color-text); }
	.controls { display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; gap: 12px; }
	.action { display: grid; place-items: center; min-height: 48px; padding: 12px; border: 1px solid var(--color-rule); border-radius: 4px; background: transparent; }
	.action:hover:not(:disabled), .quiet:hover:not(:disabled) { background: #161616; color: var(--color-text); }
	.primary { background: #ededeb; border-color: #ededeb; color: #0d0d0d; }
	.primary:hover:not(:disabled) { background: #b8b8b8; color: #0d0d0d; }
	.quiet { border: 0; background: transparent; min-height: 44px; padding: 0 8px; font-size: 12px; }
	.settings, .volume-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
	.settings { margin-top: 16px; }
	#duration { width: 48px; min-height: 44px; padding: 8px 0; text-align: center; border: 0; border-bottom: 1px solid var(--color-rule); background: transparent; }
	.audio-settings { margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--color-rule); }
	.volume-row output { margin-right: auto; }
	#volume { display: block; width: 100%; height: 44px; margin: 0; accent-color: #ededeb; cursor: pointer; }
	.audio-help { line-height: 1.6; }
	#audio-status:not(:empty) { margin-top: 12px; color: #d39292; }
	.exercises-section { padding-top: 48px; }
	.exercise-header { margin-bottom: 24px; }
	.exercise-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--color-rule); border-left: 1px solid var(--color-rule); list-style: none; padding: 0; }
	.exercise-tile { display: flex; height: 224px; padding: 24px; flex-direction: column; justify-content: space-between; border-right: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule); }
	.tile-top { display: flex; justify-content: space-between; }
	.tile-hint { margin-top: 8px; }
	.tile-focus { color: #b8b8b8; font-size: 11px; }
	@media (max-width: 640px) {
		.workout-shell { padding-inline: 24px; }
		.intro { padding: 40px 0 32px; }
		.session { grid-template-columns: minmax(0, 1fr); gap: 24px; }
		.timer-row { gap: 16px; }
		.exercise-header { align-items: start; }
		.exercise-header p { max-width: 140px; text-align: right; }
		.exercise-grid { grid-template-columns: minmax(0, 1fr); }
		.exercise-tile { height: 184px; }
		.record-dates { gap: 12px; }
	}
	@media (max-width: 359px) { #timer { font-size: 72px; } .section-header { gap: 8px; } }
</style>
