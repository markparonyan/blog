---
const title = "21 Day Core · Workout";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#101820" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Core 21" />
  <meta name="description" content="Minimal 21-day core workout timer. Nine exercises, two rounds, no rest between moves." />
  <title>{title}</title>
  <style>
    :root{color-scheme:dark;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#101820;color:#f2f4ef;font-synthesis:none}
    *{box-sizing:border-box} body{margin:0;min-height:100svh;background:radial-gradient(ellipse at 80% 0%,#203a3e 0%,#101820 53%);padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}
    button,input{font:inherit} button{cursor:pointer;touch-action:manipulation} button:focus-visible,input:focus-visible{outline:3px solid #a8efc5;outline-offset:3px}
    .wrap{max-width:550px;margin:auto;padding:24px 20px 46px}
    .top{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .brand{font-weight:850;font-size:17px;letter-spacing:-.03em}.brand b{color:#a8efc5}.home{font-size:13px;color:#cad6d1;text-decoration:none;border-bottom:1px solid #63726e;padding:4px 0}
    .eyebrow{margin:36px 0 8px;color:#a8efc5;font-size:12px;font-weight:750;letter-spacing:.16em;text-transform:uppercase}
    h1{font-size:clamp(40px,10vw,60px);line-height:1;letter-spacing:-.07em;margin:0 0 13px;font-weight:850}
    .sub{color:#adbfba;margin:0 0 23px;font-size:14px;line-height:1.6}
    .card{background:#1a282d;border:1px solid #385052;border-radius:23px;padding:22px;margin-bottom:16px;box-shadow:0 12px 30px #0002}
    .row{display:flex;align-items:center;justify-content:space-between;gap:14px}
    .label{color:#a9bdb7;font-size:12px;text-transform:uppercase;letter-spacing:.11em;font-weight:750}
    .day{font-weight:800;font-size:18px}.track{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px;margin-top:16px}
    .daydot{border:1px solid #485e60;background:#23343a;color:#b3c5c1;border-radius:10px;aspect-ratio:1;display:grid;place-items:center;font-size:12px;font-weight:700;min-width:0}
    .daydot.done{background:#a8efc5;color:#132821;border-color:#a8efc5}.daydot.current{outline:2px solid #a8efc5;outline-offset:2px}
    .stage{position:relative;overflow:hidden}.progress{height:5px;border-radius:20px;background:#365054;overflow:hidden;margin:20px 0 24px}.progress span{display:block;height:100%;background:#a8efc5;transition:width .22s linear;width:0}
    .round{color:#a8efc5;font-size:12px;text-transform:uppercase;letter-spacing:.14em;font-weight:800}
    .exercise{font-size:clamp(29px,7vw,39px);font-weight:850;line-height:1.12;letter-spacing:-.045em;margin:9px 0 3px;min-height:88px}
    .hint{color:#aec0ba;font-size:14px;min-height:22px}
    .timer{font-size:clamp(88px,24vw,128px);font-variant-numeric:tabular-nums;letter-spacing:-.09em;line-height:1;font-weight:850;margin:22px 0 12px}
    .timer.low{color:#ffb49d}.next{border-top:1px solid #3b5254;padding-top:17px;margin-top:17px;line-height:1.45;font-size:14px;color:#b8c9c4}.next strong{color:#f2f4ef}
    .controls{display:grid;grid-template-columns:56px 1fr 56px;gap:10px;margin-top:19px}
    .btn{min-height:58px;border:1px solid #526865;background:#2a3e42;color:white;border-radius:15px;font-size:22px;font-weight:750}
    .primary{background:#a8efc5;border-color:#a8efc5;color:#10261c;font-size:17px}.primary:disabled{opacity:.45}
    .minor{color:#b7cbc5;background:transparent;border:0;padding:8px 10px;font-size:13px;text-decoration:underline}
    .settings{display:flex;align-items:center;gap:10px;justify-content:space-between;margin-top:11px}
    .settings label{color:#b9c8c2;font-size:13px}.settings input{width:82px;padding:9px;color:#f2f4ef;background:#162327;border:1px solid #55706c;border-radius:10px;text-align:center}
    h2{font-size:18px;margin:0 0 15px;letter-spacing:-.02em}.list{list-style:none;margin:0;padding:0}
    .list li{display:flex;align-items:center;gap:14px;padding:12px 0;border-top:1px solid #34494b;font-size:14px;color:#d1ddd8}
    .list li:first-child{border-top:0}.list li.active{color:#a8efc5;font-weight:800}.num{font-size:12px;min-width:18px;color:#89a49b}.list small{margin-left:auto;color:#9db5ac;font-size:12px}
    .footer{color:#8fa69f;font-size:12px;line-height:1.6;margin-top:16px}
    .completed{text-align:center;padding:30px 0 12px}.completed h2{font-size:34px;color:#a8efc5}.hide{display:none!important}
    @media(prefers-reduced-motion:reduce){.progress span{transition:none}}
  </style>
</head>
<body>
<main class="wrap">
  <header class="top"><div class="brand">CORE<span style="color:#a8efc5">/</span><b>21</b></div><a class="home" href="/">← Website</a></header>
  <p class="eyebrow">Your daily core session</p>
  <h1>Show up.<br/>Do work.</h1>
  <p class="sub">9 exercises · 2 rounds · no rest between exercises · 15s between rounds.</p>
  <section class="card" aria-label="21-day progress">
    <div class="row"><span class="label">21-day challenge</span><span class="day" id="dayLabel">0 / 21 days</span></div>
    <div class="track" id="days"></div>
    <div class="row" style="margin-top:14px"><span class="label" id="streak">0-day streak</span><button class="minor" id="undoDay" type="button">Undo today</button></div>
  </section>
  <section class="card stage" aria-label="Workout timer">
    <div class="row"><span class="round" id="roundLabel">ROUND 1 / 2</span><span class="label" id="remainingTotal">12:15 total</span></div>
    <div class="progress" role="progressbar" aria-label="Workout progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="progressbar"><span id="bar"></span></div>
    <div class="exercise" id="exercise">W Raises</div>
    <div class="hint" id="hint">Slow and controlled · 10 reps target</div>
    <div class="timer" id="timer" role="timer" aria-live="off">00:40</div>
    <div class="next">UP NEXT &nbsp; <strong id="next">Knee Slides</strong></div>
    <div class="controls">
      <button class="btn" id="prev" aria-label="Previous exercise">↶</button>
      <button class="btn primary" id="toggle">Start workout</button>
      <button class="btn" id="skip" aria-label="Skip exercise">↷</button>
    </div>
    <div class="settings"><label for="duration">Seconds per exercise (20–90)</label><input id="duration" type="number" min="20" max="90" step="5" value="40" inputmode="numeric" /></div>
    <div class="row" style="margin-top:8px"><button class="minor" id="sound" type="button" aria-pressed="true">Sound: on · Test</button><button class="minor" id="reset" type="button">Reset session</button></div>
  </section>
  <section class="card hide" id="finish">
    <div class="completed"><h2>Workout complete.</h2><p>Session logged on this iPhone. Great work.</p><button class="btn primary" style="padding:0 28px" id="again">Go again</button></div>
  </section>
  <section class="card">
    <h2>Today's sequence</h2><ol class="list" id="exerciseList"></ol>
  </section>
  <p class="footer">Progress saved locally in this browser, not synced across devices. iPhone: Safari → Share → Add to Home Screen. Keep screen awake during workout; iOS may pause audio when locked. Coccyx pain? Skip any move that aggravates it, especially Russian Twists.</p>
</main>
<script is:inline>
(() => {
  "use strict";
  const moves = [
    ["W Raises","10 reps target"],
    ["Knee Slides","30–40 seconds"],
    ["Flutter Kicks","30–40 seconds"],
    ["Side Plank Hip Lifts","10 each side"],
    ["Crunches","15 reps target"],
    ["Bicycle Crunches","30–40 seconds"],
    ["Dead Bug","10 each side"],
    ["Leg Lift Overs","30–40 seconds"],
    ["Russian Twists","20 total · skip if coccyx hurts"]
  ];
  const BREAK = 15, ROUNDS = 2, DAYS = 21, KEY = "core21-progress-v1", SETTING = "core21-duration-v1";
  const $ = id => document.getElementById(id);
  const elements = { timer:$("timer"),exercise:$("exercise"),hint:$("hint"),round:$("roundLabel"),next:$("next"),total:$("remainingTotal"),bar:$("bar"),progress:$("progressbar"),toggle:$("toggle"),duration:$("duration"),list:$("exerciseList"),days:$("days"),dayLabel:$("dayLabel"),streak:$("streak"),finish:$("finish") };
  let duration = Math.max(20, Math.min(90, Number(localStorage.getItem(SETTING)) || 40));
  let index = 0, left = duration, running = false, finished = false, targetTime = 0, interval = null, sound = true, audioCtx = null;
  const stages = () => { const a=[]; for(let r=0;r<ROUNDS;r++){for(let i=0;i<moves.length;i++)a.push({round:r+1,name:moves[i][0],hint:moves[i][1],seconds:duration,move:i});if(r<ROUNDS-1)a.push({round:r+1,name:"Round break",hint:"Catch your breath · next round in 15 seconds",seconds:BREAK,move:-1});}return a; };
  const plan = () => stages();
  const clock = s => {s=Math.max(0,Math.ceil(s));return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0")};
  const today = () => { const d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0") };
  function readDays(){ try{const x=JSON.parse(localStorage.getItem(KEY)||"[]");return Array.isArray(x)?[...new Set(x.filter(v=>/^\d{4}-\d{2}-\d{2}$/.test(v)))].sort().slice(-DAYS):[]}catch{return []} }
  function renderDays(){const logs=readDays();elements.days.innerHTML="";for(let i=0;i<DAYS;i++){const dot=document.createElement("div");dot.className="daydot"+(i<logs.length?" done":"")+(i===logs.length&&logs.length<DAYS?" current":"");dot.textContent=i<logs.length?"✓":i+1;dot.title="Day "+(i+1);elements.days.append(dot)}elements.dayLabel.textContent=logs.length+" / 21 days";let streak=0;const dates=new Set(logs);const day=new Date();if(!dates.has(today()))day.setDate(day.getDate()-1);while(dates.has(day.getFullYear()+"-"+String(day.getMonth()+1).padStart(2,"0")+"-"+String(day.getDate()).padStart(2,"0"))){streak++;day.setDate(day.getDate()-1)}elements.streak.textContent=streak+"-day streak"}
  function unlockAudio(){try{audioCtx=audioCtx||new (window.AudioContext||window.webkitAudioContext)();if(audioCtx.state!=="running")void audioCtx.resume().catch(()=>{});return audioCtx}catch{return null}}
  function beep(){
    if(!sound)return;
    const ctx=unlockAudio();if(!ctx)return;
    // iOS needs AudioContext unlocked by a user gesture. On start/test, this runs during the tap.
    const when=ctx.currentTime+.02;
    for(let n=0;n<2;n++){
      const o=ctx.createOscillator(),g=ctx.createGain();
      o.type="square";o.frequency.value=n===0?880:1100;
      g.gain.setValueAtTime(.0001,when+n*.18);
      g.gain.exponentialRampToValueAtTime(.22,when+n*.18+.015);
      g.gain.exponentialRampToValueAtTime(.0001,when+n*.18+.14);
      o.connect(g);g.connect(ctx.destination);o.start(when+n*.18);o.stop(when+n*.18+.15);
    }
  }
  function render(){const a=plan(),s=a[Math.min(index,a.length-1)];elements.round.textContent=s.move<0?"REST · ROUND 2 UP NEXT":"ROUND "+s.round+" / "+ROUNDS;elements.exercise.textContent=s.name;elements.hint.textContent=s.hint;elements.timer.textContent=clock(left);elements.timer.classList.toggle("low",left<=5);elements.next.textContent=a[index+1]?.name||"Finish";const elapsed=a.slice(0,index).reduce((x,v)=>x+v.seconds,0)+(s.seconds-left),total=a.reduce((x,v)=>x+v.seconds,0);const percent=finished?100:Math.max(0,Math.min(100,100*elapsed/total));elements.bar.style.width=percent+"%";elements.progress.setAttribute("aria-valuenow",Math.round(percent));elements.total.textContent=clock(total-elapsed)+" left";elements.toggle.textContent=running?"Pause":finished?"Finished":(index===0&&left===duration?"Start workout":"Resume");elements.toggle.disabled=finished;elements.duration.disabled=running||index!==0||finished;elements.finish.classList.toggle("hide",!finished);elements.list.querySelectorAll("li").forEach((e,i)=>e.classList.toggle("active",!finished&&s.move===i));}
  function renderList(){elements.list.innerHTML="";moves.forEach((m,i)=>{const li=document.createElement("li"),n=document.createElement("span"),t=document.createElement("span"),h=document.createElement("small");n.className="num";n.textContent=String(i+1).padStart(2,"0");t.textContent=m[0];h.textContent=m[1];li.append(n,t,h);elements.list.append(li)})}
  function halt(){running=false;if(interval!==null)clearInterval(interval);interval=null}
  function complete(){halt();finished=true;left=0;const logs=readDays(),now=today();if(!logs.includes(now)){logs.push(now);localStorage.setItem(KEY,JSON.stringify(logs.slice(-DAYS)))}renderDays();beep();render()}
  function advance(){const a=plan();if(index>=a.length-1){complete();return}index++;left=a[index].seconds;beep()}
  function tick(){if(!running)return;let now=performance.now(),remaining=(targetTime-now)/1000;let safety=0;while(remaining<=0&&running&&safety++<30){const carry=-remaining;advance();if(finished)return;remaining=plan()[index].seconds-carry;targetTime=now+remaining*1000}left=Math.max(0,remaining);render()}
  function start(){if(finished)return;running=true;targetTime=performance.now()+left*1000;unlockAudio();beep();interval=setInterval(tick,100);render()}
  function pause(){if(!running)return;left=Math.max(0,(targetTime-performance.now())/1000);halt();render()}
  function reset(){halt();index=0;left=duration;finished=false;render()}
  $("toggle").addEventListener("click",()=>running?pause():start());
  $("skip").addEventListener("click",()=>{const was=running;halt();if(!finished)advance();if(!finished&&was)start();else render()});
  $("prev").addEventListener("click",()=>{const was=running;halt();finished=false;if(index>0)index--;left=plan()[index].seconds;if(was)start();else render()});
  $("reset").addEventListener("click",reset);
  $("again").addEventListener("click",reset);
  $("duration").addEventListener("change",e=>{if(running||index!==0||finished)return;const v=Math.round(Number(e.target.value)/5)*5;duration=Math.max(20,Math.min(90,Number.isFinite(v)?v:40));e.target.value=duration;localStorage.setItem(SETTING,String(duration));left=duration;render()});
  $("sound").addEventListener("click",e=>{sound=!sound;e.currentTarget.textContent="Sound: "+(sound?"on · Test":"off");e.currentTarget.setAttribute("aria-pressed",String(sound));if(sound)beep()});
  $("undoDay").addEventListener("click",()=>{const logs=readDays().filter(d=>d!==today());localStorage.setItem(KEY,JSON.stringify(logs));renderDays()});
  document.addEventListener("visibilitychange",()=>{if(!document.hidden&&running)tick()});
  elements.duration.value=duration;left=duration;renderList();renderDays();render();
})();
</script>
</body>
</html>
